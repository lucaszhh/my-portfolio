---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/Hero.astro";
import Work from "../components/sections/Work.astro";
import DesignSystem from "../components/sections/DesignSystem.astro";
import AiWorkflow from "../components/sections/AiWorkflow.astro";
import Experience from "../components/sections/Experience.astro";
import Projects from "../components/sections/Projects.astro";
import AboutMe from "../components/sections/AboutMe.astro";
import Contact from "../components/sections/Contact.astro";
---

<Layout
	title="Lucas Zarandón — Frontend Engineer"
	description="Frontend engineer specializing in architecture, design systems and Next.js migrations for production platforms with 600k+ users."
	canonical="/"
>
	<section id="hero" aria-label="Introduction">
		<Hero />
	</section>
	<section id="work" class="section" >
		<Work />
	</section>
	<section id="design-system" class="section">
		<DesignSystem />
	</section>
	<section id="ai" class="section">
		<AiWorkflow />
	</section>
	<section id="experience" class="section">
		<Experience />
	</section>
	<section id="builds" class="section">
		<Projects />
	</section>
	<section id="about" class="section">
		<AboutMe />
	</section>
	<section id="contact" class="section">
		<Contact />
	</section>
</Layout>
