---
import Layout from "../../layouts/Layout.astro";
import { caseStudies } from "../../data/caseStudies";
import StackBadges from "../../components/case-studies/StackBadges.astro";
import ButtonSecondary from "../../components/shared/ButtonSecondary.astro";

const caseStudy = caseStudies.find((item) => item.slug === "cumbre");
const pageTitle = caseStudy
    ? `Case study — ${caseStudy.title}`
    : "Case study — Cumbre";
const description = caseStudy?.summary ?? "Cumbre case study.";
const canonical = "/case-studies/cumbre";
---

<Layout title={pageTitle} description={description} canonical={canonical}>
    <section class="py-8">
        {
            !caseStudy && (
                <div class="flex flex-col gap-4">
                    <h1 class="text-3xl font-bold">
                        Case study not found
                    </h1>
                    <p class="text-sm text-gray-700 dark:text-gray-200">
                        We couldn't find the requested case study.
                    </p>
                    <a href="/" aria-label="Back to home">
                        <ButtonSecondary>Back to home</ButtonSecondary>
                    </a>
                </div>
            )
        }

        {
            caseStudy && (
                <div class="flex flex-col gap-6">
                    <header class="flex flex-col gap-4">
                        <p class="text-sm font-semibold text-[#63e] dark:text-yellow-200">
                            Case study
                        </p>
                        <h1 class="text-4xl font-bold">{caseStudy.title}</h1>
                        <p class="text-base text-gray-700 dark:text-gray-200">
                            {caseStudy.summary}
                        </p>
                        <StackBadges stack={caseStudy.stack} />
                    </header>

                    <section class="border rounded-xl p-6">
                        <h2 class="text-2xl font-bold pb-2">
                            Context and problem
                        </h2>
                        <p class="text-base text-gray-700 dark:text-gray-200">
                            {caseStudy.problem}
                        </p>
                    </section>

                    <section class="border rounded-xl p-6">
                        <h2 class="text-2xl font-bold pb-2">Approach</h2>
                        <p class="text-base text-gray-700 dark:text-gray-200">
                            {caseStudy.approach}
                        </p>
                    </section>

                    <section class="border rounded-xl p-6">
                        <h2 class="text-2xl font-bold pb-2">Results</h2>
                        <ul class="list-disc pl-5 text-base text-gray-700 dark:text-gray-200">
                            {caseStudy.results.map((result) => (
                                <li>{result}</li>
                            ))}
                        </ul>
                    </section>

                    <section class="border rounded-xl p-6">
                        <h2 class="text-2xl font-bold pb-2">Architecture</h2>
                        <pre class="bg-white dark:bg-black border rounded-lg p-4 text-xs overflow-x-auto">
                            {`Client
  └─ UI (Next.js + MUI)
      ├─ Notion-like editor
      ├─ Assessments and auto-graded activities
      ├─ CRUD flows (React Hook Form + Zod)
      └─ Reusable components

APIs / Services
  └─ Education management`}
                        </pre>
                    </section>

                    <section class="flex flex-col sm:flex-row gap-3">
                        <a href="/#contact" aria-label="Contact">
                            <ButtonSecondary>Contact</ButtonSecondary>
                        </a>
                        <a href="/" aria-label="Back to home">
                            <ButtonSecondary>Back to home</ButtonSecondary>
                        </a>
                    </section>
                </div>
            )
        }
    </section>
</Layout>
