---
// Visual-only button: always rendered inside an <a>, so it must not be a <button>.
interface Props {
    className?: string;
}
const { className = "" } = Astro.props;
---

<span
    class:list={[
        "inline-flex h-11 items-center gap-2 rounded-md border border-line px-5 text-sm font-medium text-fg transition hover:border-fg/30 hover:bg-fg/[0.04] active:scale-[0.98]",
        className,
    ]}
>
    <slot name="before" />
    <slot />
    <slot name="after" />
</span>
