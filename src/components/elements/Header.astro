---
const navItems = [
    { label: "Work", href: "/#work" },
    { label: "Experience", href: "/#experience" },
    { label: "About", href: "/#about" },
    { label: "Contact", href: "/#contact" },
];
const cvHref = "/Frontend Engineer - Lucas Zarandon.pdf";
---

<header
    class="sticky top-0 z-40 -mx-5 border-b border-line/0 px-5 sm:-mx-8 sm:px-8 header"
>
    <div class="flex h-16 items-center justify-between gap-4">
        <a
            href="/"
            class="group flex items-center gap-2 font-mono text-sm font-medium text-fg"
            aria-label="Lucas Zarandón, home"
        >
            <span
                class="grid size-7 place-items-center rounded-md border border-line bg-raised text-[13px] transition-colors group-hover:border-accent/60"
                >lz</span
            >
            <span class="hidden text-muted sm:inline">lucas zarandón</span>
        </a>

        <nav aria-label="Main" class="min-w-0">
            <ul class="flex items-center gap-0 text-[13px] sm:gap-1 sm:text-sm">
                {
                    navItems.map((item) => (
                        <li class:list={[item.label === "Experience" && "max-[400px]:hidden"]}>
                            <a
                                href={item.href}
                                data-nav-link
                                class="nav-link rounded-md px-2 py-1.5 text-muted transition-colors duration-200 hover:text-fg sm:px-3"
                            >
                                {item.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        <div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
            <button
                type="button"
                data-switch-theme
                class="grid size-9 place-items-center rounded-md border border-line text-muted transition hover:border-fg/30 hover:text-fg active:scale-95"
                aria-label="Toggle color theme"
            >
                <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="4"></circle>
                    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
                </svg>
                <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
                </svg>
            </button>
            <a
                href={cvHref}
                download="Lucas Zarandon - Frontend Engineer.pdf"
                class="inline-flex h-9 items-center gap-2 rounded-md bg-fg px-2.5 text-sm sm:px-3.5 font-medium text-bg transition hover:bg-fg/85 active:scale-[0.98]"
            >
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path>
                </svg>
                <span class="sr-only sm:not-sr-only">CV</span>
            </a>
        </div>
    </div>
</header>

<style>
    .header {
        background: rgb(var(--bg) / 0.72);
        backdrop-filter: blur(12px) saturate(140%);
        -webkit-backdrop-filter: blur(12px) saturate(140%);
        border-bottom-color: rgb(var(--line) / 0.6);
    }
    .nav-link[data-active] {
        color: rgb(var(--fg));
        background: rgb(var(--fg) / 0.06);
    }
</style>
