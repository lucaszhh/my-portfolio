---
import { links } from "../../data/links";

const year = new Date().getFullYear();
const { email, linkedin, github } = links;
---

<footer class="flex flex-col gap-4 border-t border-line py-10 text-sm text-subtle sm:flex-row sm:items-center sm:justify-between">
    <p class="font-mono text-xs">
        © {year} Lucas Zarandón · Built with Astro, Tailwind and Geist
    </p>
    <ul class="flex items-center gap-5">
        <li>
            <a class="transition-colors hover:text-fg" href={github.href} target="_blank" rel="noopener noreferrer">GitHub</a>
        </li>
        <li>
            <a class="transition-colors hover:text-fg" href={linkedin.href} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </li>
        <li>
            <a class="transition-colors hover:text-fg" href={email.href}>Email</a>
        </li>
    </ul>
</footer>
