---
import SectionHeading from "../shared/SectionHeading.astro";
import { profile } from "../../data/profile";
---

<SectionHeading index="06" label="about" title="Engineer, former teacher, still explaining things." />

<div class="grid gap-10 md:grid-cols-[12rem_1fr] md:gap-8">
    <div class="hidden md:block" aria-hidden="true"></div>
    <div class="grid items-start gap-10 lg:grid-cols-[1fr_16rem]">
        <div class="grid max-w-prose gap-5 text-lg leading-relaxed text-muted" data-reveal>
            {profile.about.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <figure class="w-48 lg:w-full" data-reveal style="--i:1">
            <div class="overflow-hidden rounded-2xl border border-line bg-surface">
                <img
                    src="/me2.png"
                    alt="Lucas Zarandón holding a small plant"
                    loading="lazy"
                    decoding="async"
                    class="w-full object-cover"
                />
            </div>
            <figcaption class="eyebrow mt-3">mendoza, argentina</figcaption>
        </figure>
    </div>
</div>
