---
import SectionHeading from "../shared/SectionHeading.astro";
import Chip from "../shared/Chip.astro";
import { featuredWork as f, work } from "../../data/work";
---

<SectionHeading
    index="01"
    label="selected work"
    title="Platforms people use every day."
    lede="Public-sector and education products in production, where I owned the frontend architecture."
/>

<article class="group grid overflow-hidden rounded-2xl border border-line bg-surface/70 lg:grid-cols-[1.35fr_1fr]" data-reveal>
    <div class="flex flex-col gap-6 p-6 sm:p-8 lg:p-10">
        <div class="flex items-center justify-between gap-4">
            <span class="eyebrow">{f.index} · {f.kind}</span>
            <span class="eyebrow">{f.period}</span>
        </div>
        <div>
            <h3 class="text-3xl font-semibold tracking-tight text-fg md:text-4xl">{f.name}</h3>
            <p class="mt-3 max-w-prose leading-relaxed text-muted">{f.summary}</p>
        </div>
        <ul class="grid gap-2.5 text-[15px] text-fg/90">
            {
                f.highlights.map((item) => (
                    <li class="flex gap-3">
                        <span class="mt-[0.6em] h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
                        <span>{item}</span>
                    </li>
                ))
            }
        </ul>
        <ul class="mt-auto flex flex-wrap gap-1.5" aria-label="Stack">
            {f.stack.map((label) => <Chip label={label} />)}
        </ul>
    </div>

    <aside class="flex flex-col justify-between gap-8 border-t border-line bg-bg/40 p-6 sm:p-8 lg:border-l lg:border-t-0 lg:p-10">
        <div>
            <p class="eyebrow mb-4">spec.json</p>
            <dl class="font-mono text-[13px] leading-7">
                {
                    f.spec.map((row) => (
                        <div class="flex justify-between gap-4 border-b border-dashed border-line/80 py-1">
                            <dt class="text-subtle">{row.key}</dt>
                            <dd class:list={["text-right", row.key === "users" ? "text-accent" : "text-fg"]}>{row.value}</dd>
                        </div>
                    ))
                }
            </dl>
        </div>
        {
            f.link && (
                <a
                    href={f.link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 self-start font-mono text-sm text-fg underline decoration-line underline-offset-4 transition hover:decoration-accent"
                >
                    {f.link.label} ↗
                </a>
            )
        }
    </aside>
</article>

<div class="mt-4 grid items-start gap-4 md:grid-cols-[0.9fr_1.1fr]">
    {
        work.map((item, index) => (
            <article
                class="flex flex-col overflow-hidden rounded-2xl border border-line bg-surface/70 transition-colors duration-300 hover:border-fg/20"
                data-reveal
                style={`--i:${index + 1}`}
            >
                {item.image && (
                    <div class="relative aspect-[16/9] overflow-hidden border-b border-line bg-raised">
                        <img
                            src={item.image.src}
                            alt={item.image.alt}
                            loading="lazy"
                            decoding="async"
                            width="1190"
                            height="892"
                            class="size-full object-cover object-top transition duration-500 ease-out hover:scale-[1.02]"
                        />
                    </div>
                )}
                <div class="flex flex-1 flex-col gap-5 p-6 sm:p-8">
                    <div class="flex items-center justify-between gap-4">
                        <span class="eyebrow">{item.index} · {item.kind}</span>
                        <span class="eyebrow">{item.period}</span>
                    </div>
                    <div>
                        <h3 class="text-2xl font-semibold tracking-tight text-fg">{item.name}</h3>
                        <p class="mt-2 leading-relaxed text-muted">{item.summary}</p>
                    </div>
                    <ul class="grid gap-2 text-[15px] text-fg/90">
                        {item.highlights.map((h) => (
                            <li class="flex gap-3">
                                <span class="mt-[0.6em] h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
                                <span>{h}</span>
                            </li>
                        ))}
                    </ul>
                    <dl class="grid grid-cols-2 gap-3 font-mono">
                        {item.spec.map((row) => (
                            <div class="flex flex-col-reverse rounded-lg border border-line bg-bg/40 px-3 py-2.5">
                                <dt class="text-[11px] text-subtle">{row.key}</dt>
                                <dd class="text-xl text-fg tabular">{row.value}</dd>
                            </div>
                        ))}
                    </dl>
                    <div class="mt-auto flex flex-wrap items-end justify-between gap-4 pt-2">
                        <ul class="flex flex-wrap gap-1.5" aria-label="Stack">
                            {item.stack.map((label) => <Chip label={label} />)}
                        </ul>
                        {item.link && (
                            <a
                                href={item.link.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="font-mono text-sm text-fg underline decoration-line underline-offset-4 transition hover:decoration-accent"
                            >
                                {item.link.label} ↗
                            </a>
                        )}
                    </div>
                </div>
            </article>
        ))
    }
</div>
