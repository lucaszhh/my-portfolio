---
import Button from "../shared/Button.astro";
import { links } from "../../data/links";

const { email, whatsapp } = links;
---

<section class="py-8">
    <h2 class="text-4xl font-bold pb-6">Contact</h2>
    <div class="flex flex-col gap-2 pb-6 text-sm">
        <div class="flex flex-col md:flex-row md:gap-2">
            <span class="font-semibold">Email:</span>
            <a class="hover:underline" href={email.href}>{email.label}</a>
        </div>
        <div class="flex flex-col md:flex-row md:gap-2">
            <span class="font-semibold">WhatsApp:</span>
            <a
                class="hover:underline"
                href={whatsapp.href}
                target={whatsapp.external ? "_blank" : undefined}
                rel={whatsapp.external ? "noopener noreferrer" : undefined}
                >{whatsapp.label}</a
            >
        </div>
    </div>
    <div
        id="form"
        class="flex flex-col text-md w-full border rounded-xl p-8 py-4 md:h-[368px] h-[464px]"
    >
        <div class="flex flex-col md:flex-row md:gap-4">
            <div class="flex flex-col w-full md:w-1/2">
                <label for="name"> Name </label>
                <input
                    class="border-2 rounded p-1 h-12 active:border-[#63e] focus:border-[#63e]"
                    type="text"
                    name="name"
                    id="name"
                />
                <small id="nameError" class="text-red-500 h-6"></small>
            </div>
            <div class="flex flex-col w-full md:w-1/2">
                <label for="email"> Email </label>
                <input
                    class="border-2 rounded p-1 h-12 active:border-[#63e] focus:border-[#63e]"
                    type="email"
                    name="email"
                    id="email"
                />
                <small id="emailError" class="text-red-500 h-6"></small>
            </div>
        </div>
        <div class="flex flex-col">
            <label for="message"> Message </label>
            <textarea
                class="border-2 rounded p-1 resize-none h-[150px] active:border-[#63e] focus:border-[#63e]"
                name="message"
                id="message"></textarea>
            <small id="messageError" class="text-red-500 h-6"></small>
            <div class="flex justify-end">
                <Button
                    className="w-full md:w-1/4 justify-center self-end"
                    id="button">Send</Button
                >
            </div>
        </div>
    </div>
</section>

<script>
    import { addConsulta } from "../../firebase/client";
    const inputName = document.querySelector(
        "#name",
    ) as HTMLInputElement | null;
    const inputEmail = document.querySelector(
        "#email",
    ) as HTMLInputElement | null;
    const inputMessage = document.querySelector(
        "#message",
    ) as HTMLInputElement | null;
    const button = document.querySelector("#button");

    const nameError = document.querySelector(
        "#nameError",
    ) as HTMLElement | null;
    const emailError = document.querySelector(
        "#emailError",
    ) as HTMLElement | null;
    const messageError = document.querySelector(
        "#messageError",
    ) as HTMLElement | null;

    const form = document.querySelector("#form") as HTMLElement | null;

    function validateForm() {
        let isValid = true;

        if (
            !inputName ||
            !inputEmail ||
            !inputMessage ||
            !nameError ||
            !emailError ||
            !messageError
        )
            return false;

        nameError.textContent = "";
        emailError.textContent = "";
        messageError.textContent = "";

        if (inputName.value.trim() === "") {
            nameError.textContent = "Name is required";
            isValid = false;
        }
        if (inputEmail.value.trim() === "") {
            emailError.textContent = "Email is required";
            isValid = false;
        } else {
            const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailPattern.test(inputEmail.value)) {
                emailError.textContent = "Please enter a valid email";
                isValid = false;
            }
        }
        if (inputMessage.value.trim() === "") {
            messageError.textContent = "Message is required";
            isValid = false;
        }

        return isValid;
    }

    button &&
        button.addEventListener("click", (e) => {
            e.preventDefault();
            if (validateForm() && inputName && inputEmail && inputMessage) {
                addConsulta({
                    name: inputName.value,
                    email: inputEmail.value,
                    message: inputMessage.value,
                });
                form &&
                    (form.innerHTML = `
                <div class="flex flex-col h-full items-center justify-center">
                    <h2 class="text-xl">Thanks for your message!</h2>
                <p class="text-center ">I'll get back to you as soon as possible.</p>
                </div>`);
            }
        });
</script>
