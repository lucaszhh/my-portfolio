---
import SectionHeading from "../shared/SectionHeading.astro";
import Chip from "../shared/Chip.astro";
import { experiences } from "../../data/experience";
import { education } from "../../data/education";
---

<SectionHeading index="04" label="experience" title="Where I've been building." />

<ol class="border-t border-line">
    {
        experiences.map((item, index) => (
            <li
                class="grid gap-4 border-b border-line py-8 md:grid-cols-[12rem_1fr] md:gap-8 md:py-10"
                data-reveal
                style={`--i:${Math.min(index, 3)}`}
            >
                <div class="flex flex-row items-baseline justify-between gap-2 md:flex-col md:justify-start">
                    <p class="font-mono text-sm text-fg tabular">{item.period}</p>
                    {item.location && <p class="eyebrow">{item.location}</p>}
                </div>
                <div>
                    <h3 class="text-xl font-semibold tracking-tight text-fg">
                        {item.role} <span class="font-normal text-muted">· {item.company}</span>
                    </h3>
                    <ul class="mt-4 grid max-w-prose gap-2.5 text-[15px] leading-relaxed text-muted">
                        {item.bullets.map((bullet) => (
                            <li class="flex gap-3">
                                <span class="mt-[0.75em] h-px w-3 shrink-0 bg-line" aria-hidden="true" />
                                <span>{bullet}</span>
                            </li>
                        ))}
                    </ul>
                    <div class="mt-5 flex flex-wrap items-center justify-between gap-4">
                        {item.stack && (
                            <ul class="flex flex-wrap gap-1.5" aria-label="Stack">
                                {item.stack.map((label) => <Chip label={label} />)}
                            </ul>
                        )}
                        {item.link && (
                            <a
                                href={item.link.href}
                                target={item.link.external ? "_blank" : undefined}
                                rel={item.link.external ? "noopener noreferrer" : undefined}
                                class="font-mono text-sm text-fg underline decoration-line underline-offset-4 transition hover:decoration-accent"
                            >
                                {item.link.label} {item.link.external ? "↗" : "↓"}
                            </a>
                        )}
                    </div>
                </div>
            </li>
        ))
    }
</ol>

<div class="mt-14 grid gap-4 md:grid-cols-[12rem_1fr] md:gap-8">
    <p class="eyebrow pt-1">education</p>
    <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2">
        {
            education.map((item) => (
                <li class="flex items-baseline justify-between gap-4 border-b border-dashed border-line/80 pb-3">
                    <span>
                        <span class="block text-sm text-fg">{item.title}</span>
                        <span class="block text-xs text-subtle">{item.org}</span>
                    </span>
                    <span class="font-mono text-xs text-subtle tabular">{item.year}</span>
                </li>
            ))
        }
    </ul>
</div>
